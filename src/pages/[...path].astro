---
import Base from '../layouts/Base.astro';
import data from '../data/phase-data.json';
import fullData from '../data/full-data.json';
import BlogListing from '../components/BlogListing.astro';
import LegalPage from '../components/LegalPage.astro';
import { legalPages } from '../lib/legal.js';

export function getStaticPaths() {
  return fullData.pages.filter((page) => page.path !== '/').map((page) => ({
    params: { path: page.path.replace(/^\//, '').replace(/\/$/, '') },
    props: { page },
  }));
}

const { page } = Astro.props;
const path = page.path.endsWith('/') ? page.path : `${page.path}/`;
const legalPage = legalPages[page.path];
const title = legalPage ? `${legalPage.title} - Saneamientos Mungia` : page.title || 'Saneamientos Mungia';
const blocks = page.blocks || [];
const cleanBlocks = blocks.filter((b, i) =>
  !(b.type === 'image' && i > 0 && blocks[i - 1]?.src === b.src) &&
  !(b.text?.startsWith('Saneamientos Mungia | Polígono Pinoa'))
);
const getImage = (part) => cleanBlocks.find((b) => b.type === 'image' && b.src.includes(part))?.src;
const navServices = data.nav.filter((x) => x.path.startsWith('/servicios/') && x.path !== '/servicios/');
const serviceCopy = cleanBlocks.filter((b) => b.type === 'h3');
const serviceCards = navServices.map((item, i) => ({
  ...item,
  image: cleanBlocks.filter((b) => b.type === 'image')[i + 2]?.src,
  text: cleanBlocks.find((b, j) => b.type === 'p' && cleanBlocks[j - 1]?.text?.toLowerCase() === item.label.toLowerCase())?.text || '',
}));
const firstHeading = cleanBlocks.find((b) => /^h[1-4]$/.test(b.type));
const firstPara = cleanBlocks.find((b) => b.type === 'p');
const heading = page.heading || firstHeading?.text || title.replace(' - Saneamientos Mungia', '');
const isLegalUnavailable = page.status === 404;
---
<Base title={title} description={legalPage?.description || page.description || `${heading} | Saneamientos Mungia en Bizkaia.`} path={path}>
  {page.path === '/servicios/' ? (
    <>
      <section class="services-top"><div class="wrap"><h1>Encuéntranos en todo Bizkaia</h1><p>Instalación, mantenimiento y rehabilitación de redes de saneamiento y tuberías en Bizkaia</p></div></section>
      <section class="section wrap"><img class="wide-photo" src={getImage('DONDE-TRABAJAMOS')} alt="Ámbito de trabajo en Bizkaia" /></section>
      <section class="section wrap"><div class="card-grid">{serviceCards.map((item) => <article class="service-card"><img src={item.image} alt="" loading="lazy" /><div><h3>{item.label}</h3><p>{item.text}</p><a href={item.path}>Saber más →</a></div></article>)}</div></section>
      <section class="urgent"><div class="wrap urgent-inner"><div><h2>Servicio de desatascos urgentes 24h</h2><p>Nuestro servicio de urgencias en desatascos está diseñado para atender con rapidez a cualquier situación crítica.</p></div><div class="urgent-phone"><a href="tel:+34944460209">94 446 02 09</a><span>o</span><a href="tel:+34601004005">601 004 005</a><small>Teléfono de urgencias</small></div></div></section>
    </>
  ) : page.path === '/blog/' ? (
    <BlogListing />
  ) : page.path === '/contacto' || page.path === '/contacto2/' ? (
    <><div class="contact-page"><section class="contact-top wrap"><h1>Contacta con nosotros</h1><p>A través de nuestro mail o rellenando nuestro formulario.</p></section><section class="wrap contact-intro"><div class="contact-info"><h2>mungia@saneamientosmungia.com</h2><p>Te responderemos lo más rápido posible y uno de nuestros expertos se pondrá en contacto contigo.</p><p>O si lo prefieres a través de nuestro teléfono <a href="tel:+34944460209">94 446 02 09</a>.</p></div><img src="/assets/source/7ac0440d1f-Frame-206.png" alt="Zonas de servicio en Bizkaia" /></section><section class="wrap contact-form-section"><form id="contact-form" class="contact-form"><h2>Presupuesto gratuito, sin compromiso</h2><div class="contact-fields"><label>Nombre (requerido)<input name="nombre" autocomplete="name" required /></label><label>Correo electrónico (requerido)<input name="correo" type="email" autocomplete="email" required /></label><label class="contact-field-wide">Asunto<input name="asunto" /></label><label class="contact-field-wide">Mensaje<textarea name="mensaje" rows="6" required></textarea></label></div><button type="submit" class="pill pill-light">Enviar</button><small>Responsable: Anulaciones Sépticas Mungia, S.L. Usaremos los datos del correo para responder a tu consulta. Puedes ejercer tus derechos escribiendo a <a href="mailto:mungia@saneamientosmungia.com">mungia@saneamientosmungia.com</a>. <a href="/política-de-privacidad/">Más información sobre privacidad</a>.</small><small>El envío abrirá tu aplicación de correo.</small></form></section><section class="wrap contact-urgent"><h3>Servicio urgente para desatascos 24 h</h3><p>Nuestro servicio de urgencias en desatascos está diseñado para atender con rapidez a cualquier situación crítica.</p><a href="tel:+34601004005">601 004 005</a></section></div></>
  ) : legalPage ? (
    <LegalPage page={legalPage} />
  ) : isLegalUnavailable ? (
    <section class="interior-hero"><div class="wrap"><h1>{heading}</h1><p>Este documento no está disponible en la web original. Su dirección se ha conservado para completar la migración cuando dispongamos del texto vigente.</p></div></section>
  ) : page.kind === 'post' ? (
    <><section class="interior-hero blog-article-hero"><div class="wrap"><span class="eyebrow">Blog</span><h1>{page.title}</h1>{page.date && <time datetime={page.date}>{new Date(page.date).toLocaleDateString('es-ES', {day:'numeric',month:'long',year:'numeric'})}</time>}</div></section><section class="section wrap article-layout"><article class="article-content">{page.featuredImage && <img class="article-featured" src={page.featuredImage} alt={page.title} />}{page.bodyHtml && <div class="migrated-content" set:html={page.bodyHtml} />}</article><aside class="article-aside"><h2>¿Necesitas ayuda?</h2><p>Atendemos urgencias de saneamiento las 24 horas.</p><a href="tel:+34601004005">601 004 005</a><a class="pill pill-dark" href="/contacto/">CONTACTA</a></aside></section></>
  ) : (
    <><section class="interior-hero"><div class="wrap"><span class="eyebrow">Saneamientos Mungia</span><h1>{heading}</h1>{page.intro && <p>{page.intro}</p>}{!page.intro && firstPara && <p>{firstPara.text}</p>}{!page.intro && !firstPara && page.extraText?.[0] && <p>{page.extraText[0]}</p>}</div></section><section class="section wrap article-layout"><article class="article-content">{page.bodyHtml ? <div class="migrated-content" set:html={page.bodyHtml} /> : <>{page.extraText?.slice(firstPara ? 0 : 1).map((text) => <p>{text}</p>)}{cleanBlocks.filter((block) => block !== firstHeading && block !== firstPara && !(page.locations?.length && block.text === '¿Dónde estamos?')).map((block) => block.type === 'image' ? <img src={block.src} alt={block.alt || ''} loading="lazy" /> : block.type === 'h1' ? <h2>{block.text}</h2> : block.type === 'h2' ? <h2>{block.text}</h2> : block.type === 'h3' ? <h3>{block.text}</h3> : block.type === 'h4' ? <h4>{block.text}</h4> : <p>{block.text}</p>)}{page.locations?.length > 0 && <section class="locations"><h2>¿Dónde estamos?</h2><div class="locations-grid">{page.locations.map((location) => <a href={location.path}>{location.label}</a>)}</div></section>}</>}</article><aside class="article-aside"><h2>¿Necesitas ayuda?</h2><p>Atendemos urgencias de saneamiento las 24 horas.</p><a href="tel:+34601004005">601 004 005</a><a class="pill pill-dark" href="/contacto/">CONTACTA</a></aside></section></>
  )}
</Base>
