---
import data from '../data/phase-data.json';
import ServiceInquiry from '../components/ServiceInquiry.astro';
import redirects from '../data/service-redirects.json';
import socialLinks from '../data/social-links.json';
import '../styles/site.css';
import { pageSeo } from '../lib/seo.js';
const { title = 'Saneamientos Mungia', description = 'Empresa de saneamiento en Bizkaia con servicio de desatascos urgentes 24h.', path = '/', noindex = false } = Astro.props;
const seo = pageSeo({ path, title, description });
const mainNav = [
  { label: 'Inicio', path: '/' },
  { label: 'Servicios', path: '/servicios/' },
  { label: 'Blog', path: '/blog/' },
];
const services = data.nav.filter((x) => x.path.startsWith('/servicios/') && x.path !== '/servicios/');
const footerServices = data.footer.filter((x) => (x.path.startsWith('/servicios/') && x.path !== '/servicios/') || x.path === '/desatrancos/');
const linkTo = (path) => redirects[path.endsWith('/') ? path : `${path}/`] || path;
const legal = data.footer.filter((x) => /aviso|política|términos/i.test(x.label));
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    {!noindex && <link rel="canonical" href={seo.url} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={seo.isPost ? 'article' : 'website'} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Saneamientos Mungia" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={seo.url} />
    <meta property="og:image" content={seo.image} />
    <meta name="twitter:card" content="summary_large_image" />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(seo.structuredData).replace(/</g, '\\u003c')} />}
    <link rel="icon" href="/assets/70586f54ec1d88f7.jpg" />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner wrap">
        <a class="brand" href="/" aria-label="Saneamientos Mungia, inicio">
          <img class="brand-main" src="/assets/77f581a8a3068608.png" alt="Anulaciones Sépticas Mungia" />
          <img class="brand-urgent" src="/assets/1ca2f5dd6ae11ad5.jpg" alt="Urgencias 24 horas · 944 460 209" />
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav" aria-label="Abrir menú">☰</button>
        <nav id="main-nav" class="main-nav" aria-label="Menú principal">
          <a class={path === '/' ? 'active' : ''} href="/">Inicio</a>
          <div class="nav-services">
            <a class={path.startsWith('/servicios/') ? 'active' : ''} href="/servicios/">Servicios <span aria-hidden="true">⌄</span></a>
            <div class="submenu">
              {services.map((item) => <a href={linkTo(item.path)}>{item.label}</a>)}
            </div>
          </div>
          <a class={path.startsWith('/blog/') ? 'active' : ''} href="/blog/">Blog</a>
          <a class="nav-contact" href="/contacto/">CONTACTO</a>
        </nav>
      </div>
    </header>
    <main>{path.startsWith('/servicios') || path === '/desatrancos/' ? <div class="service-page-shell"><div class="service-page-main"><slot /></div><div class="service-inquiry-rail"><ServiceInquiry path={path} /></div></div> : <slot />}</main>
    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div class="footer-primary">
          <a href="/">Inicio</a><a href="/servicios/">Servicios</a><a href="/blog/">Blog</a>
        </div>
        <div class="footer-links">
          {footerServices.map((item) => <a href={linkTo(item.path)}>{item.label}</a>)}
        </div>
        <nav class="footer-social" aria-label="Redes sociales">
          <span>Síguenos</span>
          <div>{socialLinks.map((social) => <a href={social.url} target="_blank" rel="noopener noreferrer" aria-label={`${social.name} (se abre en una pestaña nueva)`}>
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
              {social.icon === 'instagram' ? <><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2" /><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2" /><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" /></> : social.icon === 'facebook' ? <path fill="currentColor" d="M14 22v-9h3l.5-4H14V6.5c0-1.2.4-2 2.1-2H18V1.1A25 25 0 0 0 15.2 1C12.4 1 10 2.7 10 6v3H7v4h3v9z" /> : <><rect x="3" y="9" width="4" height="12" fill="currentColor" /><circle cx="5" cy="5" r="2" fill="currentColor" /><path fill="currentColor" d="M10 9h4v1.7c.7-1.2 1.8-2 3.5-2 3.1 0 3.5 2 3.5 5V21h-4v-6.5c0-1.6-.2-2.5-1.5-2.5S14 13 14 14.5V21h-4z" /></>}
            </svg><span>{social.name}</span>
          </a>)}</div>
        </nav>
        <div class="footer-legal">{legal.map((item) => <a href={linkTo(item.path)}>{item.label}</a>)}</div>
        <p class="footer-address">Saneamientos Mungia | Polígono Pinoa, 2-H, 48170 Zamudio, Vizcaya | <a href="mailto:mungia@saneamientosmungia.com">mungia@saneamientosmungia.com</a> | <a href="tel:+34944460209">944 46 02 09</a> |</p>
      </div>
    </footer>
    <a class="whatsapp" href="https://wa.me/34601004005" aria-label="Contactar por WhatsApp">
      <svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true" focusable="false">
        <path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
      </svg>
    </a>
    <div id="cookie-banner" class="cookie-banner" hidden>
      <strong>Preferencias de privacidad</strong>
      <span>Usamos almacenamiento técnico. El vídeo externo solo se carga si lo aceptas. <a href="/política-de-cookies/">Política de cookies</a>.</span>
      <div class="cookie-actions"><button type="button" id="reject-cookies">Rechazar</button><button type="button" id="accept-cookies">Aceptar</button></div>
    </div>
    <script>
      const toggle = document.querySelector('.menu-toggle');
      const nav = document.querySelector('#main-nav');
      const setMenuOpen = (open) => {
        toggle?.setAttribute('aria-expanded', String(open));
        toggle?.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
        nav?.classList.toggle('open', open);
      };
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        setMenuOpen(open);
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
          setMenuOpen(false);
          if (toggle instanceof HTMLElement) toggle.focus();
        }
      });
      document.addEventListener('click', (event) => {
        if (event.target instanceof Node && !nav?.contains(event.target) && !toggle?.contains(event.target)) setMenuOpen(false);
      });
      nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));
      const banner = document.querySelector('#cookie-banner');
      const choiceKey = 'sm-cookie-choice-v2';
      const readChoice = () => {
        try {
          localStorage.removeItem('sm-cookies');
          const saved = JSON.parse(localStorage.getItem(choiceKey) || 'null');
          if (!saved || !['accepted', 'rejected'].includes(saved.value)) return null;
          const expires = new Date(saved.ts);
          expires.setMonth(expires.getMonth() + 6);
          return Date.now() < expires.getTime() ? saved.value : null;
        } catch { return null; }
      };
      const saveChoice = (value) => {
        try { localStorage.setItem(choiceKey, JSON.stringify({ value, ts: Date.now() })); } catch {}
        if (banner) banner.hidden = true;
      };
      const loadVideos = () => {
        document.querySelectorAll('.video-consent[data-video-src]').forEach((holder) => {
          const src = holder.getAttribute('data-video-src') || '';
          if (!src.startsWith('https://www.youtube-nocookie.com/embed/')) return;
          const iframe = document.createElement('iframe');
          iframe.src = src;
          iframe.title = holder.getAttribute('data-video-title') || 'Vídeo externo';
          iframe.loading = 'lazy';
          iframe.allowFullscreen = true;
          holder.replaceChildren(iframe);
        });
      };
      const choice = readChoice();
      if (banner && !choice) banner.hidden = false;
      if (choice === 'accepted') loadVideos();
      document.querySelector('#accept-cookies')?.addEventListener('click', () => {
        saveChoice('accepted');
        loadVideos();
      });
      document.querySelector('#reject-cookies')?.addEventListener('click', () => {
        saveChoice('rejected');
        if (document.querySelector('.video-consent iframe')) location.reload();
      });
      document.querySelector('#show-cookie-settings')?.addEventListener('click', () => {
        if (banner) banner.hidden = false;
      });
      document.querySelectorAll('.video-consent button').forEach((button) => {
        button.addEventListener('click', () => {
          saveChoice('accepted');
          loadVideos();
        });
      });
    </script>
  </body>
</html>
