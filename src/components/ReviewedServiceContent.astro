---
import { LOCATION_MAP } from '../lib/location-map.js';
const { service } = Astro.props;
const [checklistHeading, ...checklistItems] = service.checklist;
---

<div class="migrated-content reviewed-service-content">
  {service.sections.map(([heading, parts]) => (
    <section>
      <h2>{heading}</h2>
      <p>{parts.map((part) => typeof part === 'string' ? part : <a href={part.href}>{part.label}</a>)}</p>
    </section>
  ))}
  {service.details.map(({ heading, paragraphs }) => (
    <section>
      <h2>{heading}</h2>
      {paragraphs.map((paragraph) => (
        <p>{paragraph.map((part) => typeof part === 'string' ? part : <a href={part.href}>{part.label}</a>)}</p>
      ))}
    </section>
  ))}
  <section>
    <h2>{checklistHeading}</h2>
    <ul>{checklistItems.map((item) => <li>{item}</li>)}</ul>
  </section>
  <section class="landing-faq">
    <h2>Preguntas frecuentes</h2>
    {[[service.question, service.answer], ...service.faqs].map(([question, answer]) => (
      <details>
        <summary>{question}</summary>
        <p>{answer}</p>
      </details>
    ))}
  </section>
  {service.locations.length > 0 && (
    <section class="locations">
      <h2>¿Dónde estamos?</h2>
      <figure class="location-map-figure">
        <img class="location-map" src={LOCATION_MAP} alt="Mapa de las zonas de servicio en Bizkaia" loading="lazy" />
      </figure>
      <div class="locations-grid">
        {service.locations.map(([label, path]) => <a href={path}>{label}</a>)}
      </div>
    </section>
  )}
</div>
