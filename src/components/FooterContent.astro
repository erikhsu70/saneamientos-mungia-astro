---
import { restoreLocationMap } from '../lib/location-map.js';
const { html } = Astro.props;
// Group only the original services block; keep every image, paragraph and link.
const content = restoreLocationMap(html).replace(/(<h2\b[^>]*>(?:(?!<\/h2>)[^])*?Nuestros Servicios(?:(?!<\/h2>)[^])*?<\/h2>)([^]*?)(?=<h2\b|$)/, (section, heading, body) => {
  const cards = [...body.matchAll(/<figure>[^]*?<\/figure>\s*<h3\b[^>]*>[^]*?<\/h3>\s*<p>[^]*?<\/p>\s*<p class="source-button">[^]*?<\/p>/g)].map((match) => match[0]);
  if (cards.length < 2) return section;
  const end = body.lastIndexOf(cards[cards.length - 1]) + cards[cards.length - 1].length;
  if (cards.join('').replace(/\s/g, '') !== body.slice(0, end).replace(/\s/g, '')) return section;
  return `<section class="services-section" aria-label="Nuestros servicios"><div class="services-grid-heading">${heading}</div><div class="services-grid">${cards.map((card) => `<article class="services-grid-card">${card}</article>`).join('')}</div></section>${body.slice(end)}`;
});
---
<div class="migrated-content footer-source-content" set:html={content} />
