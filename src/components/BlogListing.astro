---
import { blogPosts, blogPageCount, blogPageUrl, blogFallbackImages, POSTS_PER_PAGE } from '../lib/blog.js';

const { currentPage = 1 } = Astro.props;
const start = (currentPage - 1) * POSTS_PER_PAGE;
const posts = blogPosts.slice(start, start + POSTS_PER_PAGE);
const visiblePages = Array.from({ length: blogPageCount }, (_, i) => i + 1).filter((number) =>
  number === 1 || number === blogPageCount || Math.abs(number - currentPage) <= 2
);
---
<section class="interior-hero"><div class="wrap"><span class="eyebrow">Saneamientos Mungia</span><h1>Blog</h1><p>Sigue las últimas noticias</p></div></section>
<section class="section wrap">
  <div class="card-grid blog-grid">
    {posts.map((post, i) => <article class="news-card"><img src={post.featuredImage || post.images?.[0] || blogFallbackImages[(start + i) % blogFallbackImages.length]} alt="" loading="lazy" /><div><h2>{post.title}</h2><p>{post.description || post.intro}</p><a href={post.path}>Seguir leyendo →</a></div></article>)}
  </div>
  {blogPageCount > 1 && <nav class="blog-pagination" aria-label="Paginación del blog">
    {currentPage > 1 && <a class="pagination-step" href={blogPageUrl(currentPage - 1)} rel="prev">← Anterior</a>}
    {visiblePages.map((number, i) => <Fragment>
      {i > 0 && number - visiblePages[i - 1] > 1 && <span class="pagination-ellipsis" aria-hidden="true">…</span>}
      <a href={blogPageUrl(number)} aria-label={`Página ${number}`} aria-current={number === currentPage ? 'page' : undefined}>{number}</a>
    </Fragment>)}
    {currentPage < blogPageCount && <a class="pagination-step" href={blogPageUrl(currentPage + 1)} rel="next">Siguiente →</a>}
  </nav>}
</section>
