---
const { service } = Astro.props;
const phone = service.urgent ? '+34601004005' : '+34944460209';
const phoneLabel = service.urgent ? 'Urgencias · 601 004 005' : 'Llamar al 944 46 02 09';
---

<section class="service-landing-hero">
  <div class:list={['wrap', {'service-landing-intro': service.image}]}>
    <div>
      <h1>{service.heading}</h1>
      <p>{service.intro}</p>
      <div class="service-landing-actions">
        {service.urgent ? (
          <a class="pill pill-dark" href={`tel:${phone}`}>{phoneLabel}</a>
        ) : (
          <>
            <a class="pill pill-dark" href="/contacto/">Solicitar presupuesto</a>
            <a class="service-landing-phone" href={`tel:${phone}`}>{phoneLabel}</a>
          </>
        )}
      </div>
    </div>
    {service.image && (
      <div class="service-landing-photo">
        <figure><img src={service.image} alt="" fetchpriority="high" /></figure>
      </div>
    )}
  </div>
</section>
<section class="section wrap service-body-layout">
  <article class="article-content migrated-content">
    {service.sections.map(([heading, parts]) => (
      <section>
        <h2>{heading}</h2>
        <p>{parts.map((part) => typeof part === 'string' ? part : <a href={part.href}>{part.label}</a>)}</p>
      </section>
    ))}
    <section>
      <h2>{service.question}</h2>
      <p>{service.answer}</p>
    </section>
    {service.locations.length > 0 && (
      <details class="locations">
        <summary>Ver páginas de este servicio por municipio</summary>
        <ul class="locations-grid">
          {service.locations.map(([label, path]) => <li><a href={path}>{label}</a></li>)}
        </ul>
      </details>
    )}
  </article>
</section>

<style>
  .service-body-layout { padding-top: 0; }
  .locations { margin-top: 2.5rem; }
  summary { cursor: pointer; font-weight: 600; }
  ul.locations-grid { list-style: none; padding: 0; }
</style>
